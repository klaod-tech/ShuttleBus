# 저장소 루트의 .env — docker compose가 읽는다. .env는 저장소에 올리지 않는다 (FR-IN-08)
POSTGRES_PASSWORD=postgres
# 로그인 토큰 서명 비밀값. 공개 배포 전 반드시 긴 임의 문자열로 바꾼다
JWT_SECRET=change-me-to-a-long-random-string

# Docker 없이 로컬에서 돌릴 때는 기본값(localhost:55432, scripts/dev-db.ps1)이 이미 맞다.
# 다른 DB를 쓰려면 api/.env에 적거나 환경변수로 설정한다.
#   DATABASE_URL=postgresql+psycopg://postgres@localhost:55432/shuttlebus
#   TEST_DATABASE_URL=postgresql+psycopg://postgres@localhost:55432/shuttlebus_test
