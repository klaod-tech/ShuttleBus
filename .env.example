# 저장소 루트의 환경 파일 예시. 실제 값은 .env(또는 .env.local)에 넣고 **올리지 않는다** (FR-IN-08).
# 값은 비워 두었다 — 자리표시 문자열조차 비밀값처럼 보이면 그대로 배포되는 사고가 난다.
#
# 쓰이는 곳
#   루트 .env      docker compose가 읽는다 (postgres 비밀번호, JWT 서명값 등)
#   api/.env       Docker 없이 API를 직접 돌릴 때 pydantic-settings가 읽는다
#   프론트엔드      별도 프로젝트의 .env.local에 NEXT_PUBLIC_* 를 둔다. 이 파일에 섞지 않는다

# Docker postgres 컨테이너의 superuser 비밀번호. 직접 정한다
POSTGRES_PASSWORD=

# 로그인 토큰 서명값. 32자 이상 임의 문자열 — 예: python -c "import secrets;print(secrets.token_urlsafe(48))"
# APP_ENV=production이면 짧은 값·자리표시 값으로는 API가 기동하지 않는다
JWT_SECRET=

# development / production. production은 비밀값 검사를 켠다
APP_ENV=

# 입력자 토큰 수명(초). 비우면 86400(24시간) — 왕복 운행 중 만료를 막기 위한 값이며 refresh 토큰은 없다 (01 5장)
ACCESS_TOKEN_TTL_SECONDS=

# DB 접속 문자열. Docker compose는 자동으로 넘기므로 비워 둔다.
# Docker 없이 로컬에서 돌릴 때 기본값은 휴대용 PostgreSQL(scripts/dev-db.ps1, 포트 55432)이라 비워도 된다
DATABASE_URL=
TEST_DATABASE_URL=

# 상태 캐시·Socket.IO 전달 통로. Docker compose는 자동으로 넘긴다.
# 비우면 캐시 없이 DB 스냅샷을 읽는 예비 동작으로 돈다 (12 5장)
REDIS_URL=

# 브라우저 화면이 API를 호출할 출처. 쉼표로 구분. 예: http://localhost:3000
# 비우면 같은 출처만 허용한다. '*'는 쓰지 않는다
CORS_ORIGINS=

# 최초 관리자 계정을 사람 없이 만들 때만 쓰는 일회용 값 (python -m app.accounts bootstrap).
# 파일에 평문으로 남으므로 계정을 만든 뒤 지운다. 평소에는 비워 두고 CLI 프롬프트를 쓴다
ADMIN_BOOTSTRAP_ID=
ADMIN_BOOTSTRAP_PASSWORD=
