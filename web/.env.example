# 브라우저로 넘어가는 값만 여기 둔다 (NEXT_PUBLIC_ 접두사). 서버 비밀값은 절대 넣지 않는다 (14 4장).
# 실제 값은 web/.env.local 에 넣고 올리지 않는다. 바꾼 뒤에는 npm run dev 를 다시 시작한다.

# 카카오 developers > 앱 > 플랫폼 키 > JavaScript 키. 도메인 등록(http://localhost:3000)으로 제한된다
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=

# API 서버. 로컬 uvicorn이면 http://127.0.0.1:8000, Docker compose면 http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Socket.IO 서버 (P4). 보통 API와 같은 주소
NEXT_PUBLIC_SOCKET_URL=http://127.0.0.1:8000
